.PHONY: clean All

All:
	@echo "----------Building project:[ PECLCastroGonzalezAlex - Debug ]----------"
	@cd "PECLCastroGonzalezAlex" && "$(MAKE)" -f  "PECLCastroGonzalezAlex.mk"
clean:
	@echo "----------Cleaning project:[ PECLCastroGonzalezAlex - Debug ]----------"
	@cd "PECLCastroGonzalezAlex" && "$(MAKE)" -f  "PECLCastroGonzalezAlex.mk" clean
